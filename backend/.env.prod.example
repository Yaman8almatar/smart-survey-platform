DEBUG=False
SECRET_KEY=change-this-to-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=false

DB_NAME=smart_survey_prod
DB_USER=postgres
DB_PASSWORD=change-this
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=smart_survey_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this

REDIS_URL=redis://redis:6379/1

# The Docker image has no model runtime yet (P-16), so analysis on this stack fails with
# "config" until it is added (a later task, outside Graduation 1).
SENTIMENT_ANALYZER=local
