# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(50))"
# With an empty key and DEBUG=True the app falls back to a development key that is public in the repository, so every machine sets its own key.
SECRET_KEY=
# Key of the device-id hash (FR-04); separate from SECRET_KEY. Generate it the same way:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DEVICE_HASH_KEY=
DEBUG=True

DB_NAME=smart_survey_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# NUM_PROXIES=0

# Sentiment analysis (FR-05): M4 runs in the analysis worker on this laptop's CPU.
# Install the runtime once: .venv\Scripts\python.exe -m pip install -r backend\requirements-ml.txt
# Every model file is checked against backend/infrastructure/model_manifests/ (the files T-2 evaluated);
# other files are refused.
SENTIMENT_ANALYZER=local
SENTIMENT_MODEL_PATH=C:\t2\models\m4
SENTIMENT_MODEL_ID=clapAI/roberta-base-multilingual-sentiment

# Remote fallback. The Hugging Face router does not serve M4, so it runs another model.
# SENTIMENT_ANALYZER=huggingface
# HF_API_TOKEN=
# HF_SENTIMENT_MODEL_URL=https://router.huggingface.co/hf-inference/models/<model id>

# Email (FR-15). With these commented, the console backend prints each email in the server window.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=Smart Survey <no-reply@smartsurvey.local>
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=

# Invitation links (FR-10) open the respondent app at this address. Keep the default for the demo on this laptop.
# APP_PUBLIC_URL=http://localhost:5000

# Optional. Leave commented for daily work and the demo.
# REDIS_URL=redis://127.0.0.1:6379/1
# CORS_ALLOWED_ORIGINS=https://app.example.com
# SECURE_SSL_REDIRECT=true
