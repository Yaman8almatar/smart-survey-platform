# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(50))"
# With an empty key and DEBUG=True the app falls back to a development key that is public in the repository, so every machine sets its own key.
SECRET_KEY=
DEBUG=True

DB_NAME=smart_survey_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# NUM_PROXIES=0

HF_API_TOKEN=replace-this-token
HF_SENTIMENT_MODEL_URL=https://api-inference.huggingface.co/models/cardiffnlp/twitter-roberta-base-sentiment-latest

# Optional. Leave commented for daily work and the demo.
# USE_CELERY=false
# REDIS_URL=redis://127.0.0.1:6379/1
# CORS_ALLOWED_ORIGINS=https://app.example.com
# SECURE_SSL_REDIRECT=true
